// Reglas de seguridad de Firestore para Food on Wheels.
// Cópialas en: Consola de Firebase → Firestore Database → pestaña "Reglas" → Publicar.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function soyYo(uid) { return logueado() && request.auth.uid == uid; }
    function pedido(pid) { return get(/databases/$(database)/documents/pedidos/$(pid)).data; }
    // Es admin quien tiene un documento con su uid en la colección "admins" (se crea a mano en la consola).
    function esAdmin() { return logueado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function noBloqueado() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.bloqueado == false; }
    function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Paso siguiente de un pedido según su tipo de entrega (recoger no tiene "en camino")
    function siguiente(entrega, estado) {
      return (entrega == 'recoger'
        ? {'pendiente': 'en preparación', 'en preparación': 'listo', 'listo': 'entregado', 'en camino': 'entregado'}
        : {'pendiente': 'en preparación', 'en preparación': 'listo', 'listo': 'en camino', 'en camino': 'entregado'}
      ).get(estado, 'ninguno');
    }
    // El admin solo puede avanzar un paso o cancelar; un pedido entregado o cancelado ya no cambia de estado.
    function cambioDeEstadoValido() {
      let antes = resource.data.estado;
      let despues = request.resource.data.estado;
      return despues == antes
          || despues == siguiente(resource.data.entrega, antes)
          || (despues == 'cancelado' && !(antes in ['entregado', 'cancelado']));
    }
    // El id del pedido debe ser el consecutivo que se acaba de reservar en la misma transacción
    function idConsecutivo(id) {
      return request.resource.data.id == getAfter(/databases/$(database)/documents/contadores/pedidos).data.n
          && id == string(request.resource.data.id);
    }

    match /admins/{uid} {
      allow read: if soyYo(uid);   // cada quien solo puede comprobar si él mismo es admin
      allow write: if false;       // nadie se puede hacer admin desde la web
    }

    match /usuarios/{uid} {
      allow read: if soyYo(uid) || esAdmin();
      allow create: if soyYo(uid)
                    && request.resource.data.bloqueado == false
                    && request.resource.data.correo == request.auth.token.email;
      // El cliente edita sus datos y su carrito, pero NO puede desbloquearse ni cambiar su correo.
      allow update: if esAdmin() || (soyYo(uid) && !cambia().hasAny(['bloqueado', 'correo']));
      allow delete: if false;   // las cuentas no se eliminan: se bloquean (los pedidos conservan a su dueño)
    }

    // Contador de pedidos: solo puede subir de 1 en 1
    match /contadores/{c} {
      allow read: if logueado();
      allow create: if logueado() && request.resource.data.n == 1;
      allow update: if logueado() && request.resource.data.n == resource.data.n + 1;
      allow delete: if esAdmin();   // al reiniciar los datos de prueba
    }

    match /pedidos/{id} {
      allow read: if esAdmin() || (logueado() && resource.data.uid == request.auth.uid);
      allow create: if logueado() && idConsecutivo(id)
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.get('descontado', false) == false
                    && (
                      // pedido normal del cliente
                      (request.resource.data.uid == request.auth.uid && noBloqueado() && !('reposicionDe' in request.resource.data))
                      // reposición sin costo creada por el admin al aprobar un reclamo
                      || (esAdmin() && 'reposicionDe' in request.resource.data)
                    );
      allow update: if (esAdmin() && cambioDeEstadoValido())
                    // el cliente solo puede cancelar su pedido mientras está pendiente
                    || (logueado() && resource.data.uid == request.auth.uid
                        && resource.data.estado == 'pendiente'
                        && request.resource.data.estado == 'cancelado'
                        && request.resource.data.canceladoPor == 'cliente'
                        && cambia().hasOnly(['estado', 'motivoCancelacion', 'canceladoPor', 'tiempos']));
      allow delete: if esAdmin();
    }

    // Reclamos: uno por pedido, solo de pedidos propios entregados hace menos de 24 horas
    match /reclamos/{pid} {
      allow read: if esAdmin() || (logueado() && resource.data.uid == request.auth.uid);
      allow create: if logueado()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.estado == 'abierto'
                    && pid == string(request.resource.data.pedidoId)
                    && pedido(pid).uid == request.auth.uid
                    && pedido(pid).estado == 'entregado'
                    && request.time.toMillis() - pedido(pid).tiempos.entregado < 86400000;
      allow update, delete: if esAdmin();
    }

    // Suscripciones FoW Prime: número consecutivo (SUS-0001…); cada cliente ve las suyas para descargar su factura
    match /membresias/{id} {
      allow read: if esAdmin() || (logueado() && resource.data.uid == request.auth.uid);
      allow create: if logueado() && request.resource.data.uid == request.auth.uid && noBloqueado()
                    && request.resource.data.numero == getAfter(/databases/$(database)/documents/contadores/membresias).data.n
                    && id == string(request.resource.data.numero);
    }

    // Chat cliente ↔ restaurante: uno por pedido (el id del chat es el número del pedido).
    // Solo se escribe mientras el pedido está en curso: al entregarse o cancelarse el chat queda cerrado
    // (se puede leer el historial, pero ya no se aceptan mensajes).
    match /chats/{pid} {
      function esDueno() { return logueado() && pedido(pid).uid == request.auth.uid; }
      function chatAbierto() { return !(pedido(pid).estado in ['entregado', 'cancelado']); }
      function nuevo() { return request.resource.data; }
      // El último mensaje (portada) debe ser texto de 1 a 500 caracteres, con la hora del servidor,
      // y "de" debe corresponder a quien escribe
      function ultimoValido() {
        let u = nuevo().ultimo;
        return u.keys().hasOnly(['texto', 'de', 'fecha']) && u.texto is string && u.texto.size() > 0 && u.texto.size() <= 500
            && u.fecha == request.time
            && ((u.de == 'cliente' && esDueno()) || (u.de == 'admin' && esAdmin()));
      }
      // get: también funciona cuando el chat aún no existe (se comprueba con el pedido)
      allow get: if esAdmin() || esDueno();
      allow list: if esAdmin() || (logueado() && resource.data.uid == request.auth.uid);
      // El primer mensaje crea la portada con los datos del pedido
      allow create: if chatAbierto() && ultimoValido()
                    && nuevo().keys().hasOnly(['pedidoId', 'uid', 'nombre', 'creado', 'actualizado', 'ultimo', 'sinLeerCliente', 'sinLeerAdmin'])
                    && pid == string(nuevo().pedidoId)
                    && nuevo().uid == pedido(pid).uid
                    && nuevo().nombre == pedido(pid).cliente.nombre
                    && nuevo().creado == request.time && nuevo().actualizado == request.time
                    && nuevo().sinLeerCliente == (nuevo().ultimo.de == 'admin' ? 1 : 0)
                    && nuevo().sinLeerAdmin == (nuevo().ultimo.de == 'cliente' ? 1 : 0);
      allow update: if
          // enviar un mensaje: cambia el último mensaje y suma 1 a los no leídos del otro lado
          (chatAbierto() && ultimoValido() && nuevo().actualizado == request.time && (
              (nuevo().ultimo.de == 'cliente' && cambia().hasOnly(['ultimo', 'actualizado', 'sinLeerAdmin']) && nuevo().sinLeerAdmin == resource.data.sinLeerAdmin + 1)
           || (nuevo().ultimo.de == 'admin' && cambia().hasOnly(['ultimo', 'actualizado', 'sinLeerCliente']) && nuevo().sinLeerCliente == resource.data.sinLeerCliente + 1)))
          // marcar como leído (también con el chat cerrado): cada lado solo pone en 0 su propio contador
          || (esDueno() && cambia().hasOnly(['sinLeerCliente']) && nuevo().sinLeerCliente == 0)
          || (esAdmin() && cambia().hasOnly(['sinLeerAdmin']) && nuevo().sinLeerAdmin == 0);
      allow delete: if esAdmin();   // al reiniciar los datos de prueba

      match /mensajes/{m} {
        allow read: if esAdmin() || esDueno();
        allow create: if chatAbierto()
                      && nuevo().keys().hasOnly(['de', 'uid', 'nombre', 'texto', 'fecha'])
                      && nuevo().uid == request.auth.uid
                      && nuevo().texto is string && nuevo().texto.size() > 0 && nuevo().texto.size() <= 500
                      && nuevo().nombre is string && nuevo().nombre.size() <= 80
                      && nuevo().fecha == request.time
                      && ((nuevo().de == 'cliente' && esDueno()) || (nuevo().de == 'admin' && esAdmin()));
        allow update: if false;           // los mensajes no se editan
        allow delete: if esAdmin();
      }
    }

    // Catálogo: lo ve cualquiera (también visitantes), solo el admin lo modifica.
    match /productos/{id}  { allow read: if true; allow write: if esAdmin(); }
    match /categorias/{id} { allow read: if true; allow write: if esAdmin(); }
    // Eventos: descuentos por producto o por categoría que el admin enciende y apaga
    match /eventos/{id}    { allow read: if true; allow write: if esAdmin(); }
    // Imagen grande de cada producto (la miniatura va dentro del producto)
    match /imagenes/{id}   { allow read: if true; allow write: if esAdmin(); }
    // Unidades vendidas por producto: alimenta «Los más pedidos» del cliente
    match /stats/{id}      { allow read: if true; allow write: if esAdmin(); }
    match /inventario/{id} { allow read: if true; allow write: if esAdmin(); }
    // config/tienda (datos del negocio, envío y Prime) y config/banner
    match /config/{id}     { allow read: if true; allow write: if esAdmin(); }

    match /historial/{id}  { allow read, write: if esAdmin(); }
  }
}
