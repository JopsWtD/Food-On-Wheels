// Reglas de seguridad de Firestore para Food on Wheels.
// Cópialas en: Consola de Firebase → Firestore Database → pestaña "Reglas" → Publicar.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function soyYo(uid) { return logueado() && request.auth.uid == uid; }
    // Es admin quien tiene un documento con su uid en la colección "admins" (se crea a mano en la consola).
    function esAdmin() { return logueado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function noBloqueado() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.bloqueado == false; }

    match /admins/{uid} {
      allow read: if soyYo(uid);   // cada quien solo puede comprobar si él mismo es admin
      allow write: if false;       // nadie se puede hacer admin desde la web
    }

    match /usuarios/{uid} {
      allow read: if soyYo(uid) || esAdmin();
      allow create: if soyYo(uid)
                    && request.resource.data.bloqueado == false
                    && request.resource.data.correo == request.auth.token.email;
      // El cliente edita sus datos y su carrito, pero NO puede desbloquearse ni cambiar su correo.
      allow update: if esAdmin()
                    || (soyYo(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bloqueado', 'correo']));
      allow delete: if esAdmin();
    }

    match /pedidos/{id} {
      allow read: if esAdmin() || (logueado() && resource.data.uid == request.auth.uid);
      allow create: if logueado()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.estado == 'pendiente'
                    && noBloqueado();
      allow update, delete: if esAdmin();   // solo el admin cambia estados
    }

    match /membresias/{id} {
      allow read: if esAdmin();
      allow create: if logueado() && request.resource.data.uid == request.auth.uid && noBloqueado();
    }

    // Catálogo: lo ve cualquiera (también visitantes), solo el admin lo modifica.
    match /productos/{id}  { allow read: if true; allow write: if esAdmin(); }
    match /inventario/{id} { allow read: if true; allow write: if esAdmin(); }
    match /config/{id}     { allow read: if true; allow write: if esAdmin(); }

    match /historial/{id}  { allow read, write: if esAdmin(); }
  }
}
